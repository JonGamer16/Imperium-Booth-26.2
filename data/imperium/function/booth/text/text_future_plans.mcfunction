# Future plans board
execute at @s run summon text_display ~ ~ ~ \
    {Tags:["summit.booth_entity.imperium", "im_walltext","im_credits"],\
    billboard:"fixed",\
    alignment:"center",\
    line_width:340,\
    text:[\
        {text:"Future Ideas and Projects",color:"gold"}]}

execute at @s run summon text_display ~ ~ ~ \
    {Tags:["summit.booth_entity.imperium", "im_walltext","im_credits"],\
    billboard:"fixed",\
    alignment:"center",\
    line_width:340,\
    text:[\
        {text:"Ferrets by TheUwuFurry",color:"gold",bold:true},\
            {text:" - WIP survival server with custom plugins inspired by servers like Monumenta and Loka. Magic, dungeons, wars, worldgen, and lots of custom items.\n",color:"yellow",bold:false},\
        {text:"Imperium Mundi, by NameUser",color:"gold",bold:true},\
            {text:" - The original plugin for the Imperium KitPvP server is stashed away in a repo. Restoration efforts have been started. If finished, it will likely be playable on Ferrets.\n",color:"yellow",bold:false},\
        {text:"SMPerium",color:"gold",bold:true},\
            {text:" - I might make this pack survival-compatible, so you can craft the items and combine kit abilities.\n",color:"yellow",bold:false},\
        {text:"A Standalone Game",color:"gold",bold:true},\
            {text:" - I did a little bit of prototyping for a challenging top-down game where your cursor swipes perform various sword attacks.\n",color:"yellow",bold:false},\
        {text:"So many ideas, so little attention span...",color:yellow,bold:false}]}

